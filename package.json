{
  "name": "akili",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Akili — Laetoli's sovereign Swahili AI: one brain that routes to domain experts (Afya/TibaAI, Fasihi+Lugha/Kasuku, SNIL-as-tool). No external LLM.",
  "bin": {
    "akili": "dist-cli/akili.js"
  },
  "exports": {
    "./engine": {
      "types": "./pkg/index.d.ts",
      "import": "./pkg/index.js"
    }
  },
  "files": ["pkg", "src", "cli", "examples"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.embed.config.ts",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:cli": "esbuild cli/akili.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-cli/akili.js --banner:js=\"#!/usr/bin/env node\"",
    "build:pkg": "tsup --config tsup.pkg.config.ts",
    "build:all": "npm run build && npm run build:cli",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@laetoli/snil": "github:nooher/snil-core",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
